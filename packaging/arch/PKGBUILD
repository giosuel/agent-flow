# Maintainer: giosuel <me@giosuel.ch>
# AgentFlow for Arch Linux (AUR), as two packages (the owner, 2026-11-13): agentflow, the server,
# and agentflow-client, with flow and agentflow-builder. On the server, both; then:
#   sudo agentflow setup --public-url https://flow.example --agents-user <user>   (see README)
# On other machines, agentflow-client only.
pkgbase=agentflow
pkgname=(agentflow agentflow-client)
pkgver=0.1.0
pkgrel=1
pkgdesc="Project management for Claude agents and their owner"
arch=('x86_64' 'aarch64')
url="https://github.com/giosuel/agent-flow"
license=('AGPL-3.0-or-later')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "agent-flow-$pkgver"
  # The version comes from the tag; a release tarball has no .git to work it out from.
  sed -i "s/^version = \"0.0.0-dev\"/version = \"$pkgver\"/" Cargo.toml
  sed -i "/^name = \"agentflow\"$/{n;s/^version = \"0.0.0-dev\"/version = \"$pkgver\"/}" Cargo.lock
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "agent-flow-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "agent-flow-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package_agentflow-client() {
  pkgdesc="AgentFlow's command, flow, and its builder (agentflow-builder)"
  depends=('gcc-libs' 'glibc' 'openssl' 'zlib' 'zstd' 'git')
  install=agentflow-client.install
  cd "agent-flow-$pkgver"
  install -Dm755 target/release/flow "$pkgdir/usr/bin/flow"
  install -Dm755 target/release/agentflow-builder "$pkgdir/usr/bin/agentflow-builder"
  sed 's|@BIN@|/usr/bin/agentflow-builder|' packaging/system/agentflow-builder.service |
    install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/agentflow-builder.service"
}

package_agentflow() {
  depends=('gcc-libs' 'glibc' 'openssl' 'zlib' 'zstd' 'git' 'systemd' "agentflow-client=$pkgver")
  optdepends=('github-cli: the merge and release buttons, pull request status')
  install=agentflow.install
  cd "agent-flow-$pkgver"
  install -Dm755 target/release/agentflow "$pkgdir/usr/bin/agentflow"
  sed 's|@BIN@|/usr/bin/agentflow|' packaging/system/agentflow.service |
    install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/agentflow.service"
  sed 's|@BIN@|/usr/bin/agentflow|' packaging/system/agentflow-hands.service |
    install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/agentflow-hands.service"
  # pacman's systemd hook creates the user from this on install.
  install -Dm644 packaging/system/agentflow.sysusers "$pkgdir/usr/lib/sysusers.d/agentflow.conf"
  install -Dm644 README.md "$pkgdir/usr/share/doc/agentflow/README.md"
}
